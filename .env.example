# OpenRouter (any OpenAI-compatible endpoint works: change BASE_URL and MODEL_NAME)
API_KEY=''
BASE_URL='https://openrouter.ai/api/v1'
MODEL_NAME='anthropic/claude-haiku-5.5'

# Optional: sampling and agent budget
LLM_TEMPERATURE='0.2'
LLM_REASONING='off'
AGENT_MAX_STEPS='14'

# Optional: identifies the app to OpenStreetMap/Wikimedia APIs (their usage policies require it)
HTTP_USER_AGENT='progulka/0.1 (+https://github.com/dgornin/progulka)'

# Optional: 1 = answer repeated LLM requests from the on-disk cache (reproducible demo)
LLM_REPLAY='0'
