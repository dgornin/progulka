# OpenRouter (any OpenAI-compatible endpoint works: change BASE_URL and MODEL_NAME)
API_KEY=
BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-haiku-5.5

# Optional: sampling and agent budget
LLM_TEMPERATURE=0.2
LLM_REASONING=off
AGENT_MAX_STEPS=14

# Optional: identifies the app to OpenStreetMap/Wikimedia APIs (their usage policies require it)
HTTP_USER_AGENT=progulka/0.1 (+https://github.com/dgornin/progulka)

# Optional: 1 = answer repeated LLM requests from the on-disk cache (reproducible demo)
LLM_REPLAY=0
# Optional: pin "today" (YYYY-MM-DD). The brief prompt contains today's date, so a run
# rehearsed on another day replays from the cache only with the same pinned date.
# TODAY=2026-10-20

# Optional: Overpass mirrors, comma-separated; the one that answered last is tried first
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://overpass.private.coffee/api/interpreter
# Optional: where the HTTP and LLM caches live (default: .cache in the repo). Leave it
# unset for docker compose: the image sets /srv/cache, where the repo's .cache is mounted.
# CACHE_DIR=/path/to/cache

# Public deployment guards (0 = off): runs per hour per visitor, LLM spend per day (UTC),
# runs at once. Turn them on on a server: anyone with the link spends the API key.
# RATE_LIMIT_PER_HOUR=10
# DAILY_BUDGET_USD=2
# MAX_CONCURRENT_RUNS=3
# Server only: the address Caddy serves and gets an HTTPS certificate for
# SITE_ADDRESS=progulka.gornin.com, 185-156-108-126.sslip.io

# Accounts and saved trips: a SQLite file in DATA_DIR (default: .data in the repo; the
# Docker image uses /srv/data, where docker compose mounts ./data). DATABASE_URL
# overrides the whole URL, e.g. another SQLite file or a server database.
# DATA_DIR=/path/to/data
# DATABASE_URL=sqlite+aiosqlite:////path/to/progulka.db
# 1 = the session cookie is sent over HTTPS only (docker-compose.prod.yml sets it).
# COOKIE_SECURE=1

# Accounts created at startup; changing a password here resets it at the next start.
# The demo account is shown on the login page so a visitor can try the app at once.
DEMO_EMAIL=demo@progulka.app
DEMO_PASSWORD=progulka-demo
# The admin account sees usage and costs at /app/admin. Never shown anywhere.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
